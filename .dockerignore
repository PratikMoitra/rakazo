# Credentials, dumps and agent scratch never belong in an image. CI builds from a clean checkout;
# these keep an untracked file out of a fallback build on a host checkout. infra/compose/
# check-image.sh fails the publish if one still gets in.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ecdsa*
**/id_ed25519*
**/*.csv
**/*.dump
**/*.sqlite
.context
.claude
.deepsec
.tmp
.playwright-cli
.deploy.lock
.last-deployed-revision

# Phase-1 fixture entrypoints and tests are not part of a deployment image.
# The production flag rejection stays in the worker source and is not listed below.
apps/worker/src/phase1-fixture-secret-store.ts
apps/worker/src/phase1-cleanup-fixture-main.ts
apps/worker/src/phase1-fixture-boundary.test.ts
apps/api/src/phase1-fixture-cluster.ts
apps/api/src/phase1-fixture-env.ts
apps/api/src/phase1-fixture-env.test.ts
apps/api/src/phase1-queue.postgres.test.ts
apps/api/src/phase1-cleanup-once.ts
**/*.test.ts
**/*.postgres.test.ts
